# kiwi-companion: the bot, the speech library and the Claude Code program (for the claude-code
# brain; unmodified, from npm). Speech models are not in the image: fetched once into /models.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends bzip2 ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code@2.1.332 \
 && npm cache clean --force

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src

# its data and models belong to the image's user, so named volumes start out owned by it
RUN mkdir -p /data /models && chown node:node /data /models
USER node
ENV NODE_ENV=production DATA_DIR=/data SPEECH_DIR=/models HOME=/data/home
VOLUME ["/data", "/models"]

HEALTHCHECK --interval=60s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "process.exit(Date.now()-require('fs').statSync('/tmp/alive').mtimeMs<120000?0:1)"

ENTRYPOINT ["tini", "--", "node", "src/main.js"]
