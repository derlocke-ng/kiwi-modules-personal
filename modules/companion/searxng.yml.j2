# SearXNG for the companion: JSON answers on the stack network only. Its key comes from the
# environment (SEARXNG_SECRET), not from this file.
use_default_settings: true
general:
  instance_name: companion
  enable_metrics: false
server:
  limiter: false
  image_proxy: false
  public_instance: false
search:
  formats: [json]
  safe_search: 0
  autocomplete: ""
outgoing:
  request_timeout: 4.0
