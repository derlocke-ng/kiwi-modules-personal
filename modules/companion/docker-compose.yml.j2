# companion — a Discord companion for one person. It only connects out: to Discord, to the
# local AI, and (when set) to GitHub's public API and to Claude. No port, no web page.
services:
  {{ container_prefix }}-companion:
    image: {{ image }}
    container_name: {{ container_prefix }}-companion
    environment:
      - TZ={{ timezone }}
      - OWNER={{ owner }}
      - DISCORD_TOKEN={{ bot_token }}
      - BRAINS={{ brains | join(',') }}
      - LANGUAGES={{ languages | join(',') }}
      - GITHUB_USER={{ github_user }}
      - WEB={{ '1' if web else '0' }}
      - LISTEN={{ listen }}
      - CHECKIN={{ checkin }}
      - NAME={{ name }}
      - VOICE={{ voice }}
      - VOICE_DE={{ voice_de }}
      - AI_URL={{ ai_url_effective }}
      - AI_KEY={{ ai_key }}
      - AI_LOAD={{ '1' if ai_load else '0' }}
      - AI_MODEL={{ ai_model }}
      - AI_QUANT={{ ai_quant }}
      - AI_CONTEXT={{ ai_context }}
      - CLAUDE_CODE_OAUTH_TOKEN={{ claude_token }}
      - CLAUDE_MODEL={{ claude_model }}
      - ANTHROPIC_API_KEY={{ anthropic_key }}
      - ANTHROPIC_MODEL={{ anthropic_model }}
      - OPENAI_URL={{ openai_url }}
      - OPENAI_API_KEY={{ openai_key }}
      - OPENAI_MODEL={{ openai_model }}
      - SPEECH_THREADS={{ speech_threads }}
      - END_SILENCE_MS={{ pause }}
      - BACKUP_URL={{ backup_url }}
      - BACKUP_KEY={{ backup_key }}
      - BACKUP_MODEL={{ backup_model }}
{% if web %}
      - SEARCH_URL=http://{{ container_prefix }}-companion-search:8080
{% endif %}
{% if ca_cert_dir %}
      - NODE_EXTRA_CA_CERTS=/kiwi-ca/kiwiCA.crt
{% endif %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    read_only: true
    tmpfs: [/tmp]
    cap_drop:
      - ALL
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "node", "-e", "process.exit(Date.now()-require('fs').statSync('/tmp/alive').mtimeMs<120000?0:1)"]
      interval: 60s
      timeout: 5s
      start_period: 90s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - companion_data:/data
      - companion_models:/models
{% if ca_cert_dir %}
      - {{ ca_cert_dir }}:/kiwi-ca:ro,z
{% endif %}

{% if web %}
  # SearXNG: the companion's own web search. It asks the search engines from this machine and
  # answers only on the stack network (no port, no site of the proxy).
  {{ container_prefix }}-companion-search:
    image: {{ search_image }}
    container_name: {{ container_prefix }}-companion-search
    environment:
      - SEARXNG_SECRET={{ search_secret }}
      - SEARXNG_BASE_URL=http://{{ container_prefix }}-companion-search:8080/
    networks:
      {{ network_name }}: {}
    tmpfs: [/var/cache/searxng]
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - DAC_OVERRIDE
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-companion-search/settings.yml:/etc/searxng/settings.yml:ro,z
{% endif %}

volumes:
  companion_data:
  companion_models:
