# smartfritz — light schedules for plugs on a FRITZ!Box
# On the stack network, not inside the VPN client: it needs the LAN, and a VPN restart must not stop the schedule.
services:
  {{ container_prefix }}-smartfritz:
    image: {{ image }}
    container_name: {{ container_prefix }}-smartfritz
    environment:
      - SMARTFRITZ_FRITZ_URL={{ fritz_url }}
      - SMARTFRITZ_FRITZ_USER={{ fritz_user }}
      - SMARTFRITZ_FRITZ_PASSWORD={{ fritz_password }}
      - SMARTFRITZ_APP_PASSWORD={{ app_password }}
      - SMARTFRITZ_FRITZ_CERT_AUTO={{ '1' if cert_auto else '0' }}
      - TZ={{ timezone }}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    read_only: true
    cap_drop:
      - ALL
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8080/healthz', timeout=4)"]
      interval: 60s
      timeout: 5s
      start_period: 30s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - smartfritz_data:/data

volumes:
  smartfritz_data:
